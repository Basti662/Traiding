# Datei umbenennen zu ".env" (ohne .example) und mit deinen echten Testnet-Keys füllen
# NIEMALS diese Datei mit echten Keys committen/teilen/hochladen!

BINANCE_API_KEY=hier_deinen_testnet_api_key_einfügen
BINANCE_API_SECRET=hier_dein_testnet_secret_einfügen

# Optional: nur auf dem Raspberry Pi setzen, wenn du das Dashboard von einem
# anderen Gerät im selben Netzwerk (Laptop, Handy) erreichen willst.
# Auf Windows/lokal einfach weglassen (Standard: 127.0.0.1).
# DASHBOARD_HOST=0.0.0.0
